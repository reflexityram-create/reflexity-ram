/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://www.googletagmanager.com https://static.cloudflareinsights.com https://apis.google.com https://www.gstatic.com https://www.google.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://www.google-analytics.com https://*.googleusercontent.com; connect-src 'self' https://reflexity-ram.onrender.com https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; frame-src https://accounts.google.com https://www.google.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/theme-bootstrap.js
  Cache-Control: public, max-age=0, must-revalidate

/analytics-bootstrap.js
  Cache-Control: public, max-age=0, must-revalidate

/font-bootstrap.js
  Cache-Control: public, max-age=0, must-revalidate

/error-bootstrap.js
  Cache-Control: public, max-age=0, must-revalidate

/merchant-widget-bootstrap.js
  Cache-Control: public, max-age=0, must-revalidate

/og-image.jpg
  Cache-Control: public, max-age=86400

/feed-images/*
  Cache-Control: public, max-age=86400

# Only the custom domain is canonical. Keep every *.pages.dev alias (the production alias
# and each branch preview) out of search results so they cannot compete as duplicates.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# The OCR engine (Tesseract compiled to WebAssembly) reads "Made in" off label photos on the admin page.
# WebAssembly needs 'wasm-unsafe-eval', which no other path gets: this block REPLACES the site-wide policy
# for /ocr/ only (a worker takes the policy of its own script's response, not the page's). Keep it last: rules
# apply in file order. public/ocr/csp-probe.js is the self-test.
/ocr/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'
  Cache-Control: public, max-age=86400
