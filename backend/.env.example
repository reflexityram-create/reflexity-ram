# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=<mongodb-connection-string>

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<replace-with-a-random-64-byte-secret>
JWT_EXPIRES_IN=7d

# Browser origins and public frontend URL
ALLOWED_ORIGINS=http://localhost:5173,https://reflexityram.com
FRONTEND_URL=http://localhost:5173

# Resend email
RESEND_API_KEY=<resend-api-key>
FROM_EMAIL=Reflexity RAM <noreply@reflexityram.com>
# Optional internal recipient for quote and hardware-acquisition enquiries.
# Defaults to reflexityram@gmail.com when unset.
LEADS_TO_EMAIL=<internal-lead-recipient>

# Cloudinary product images
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Stripe hosted Checkout
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>
STRIPE_CURRENCY=cad

# Optional Google sign-in
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Local/admin seed script. There is deliberately no default admin password.
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<unique-admin-password-at-least-12-characters>

# Optional one-time HTTP seed route. Leave unset to keep /api/seed disabled.
# SEED_SECRET=<one-time-seed-secret>
