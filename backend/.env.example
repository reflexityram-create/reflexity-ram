# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=<mongodb-connection-string>

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<replace-with-a-random-64-byte-secret>
JWT_EXPIRES_IN=7d

# Browser origins and public frontend URL
ALLOWED_ORIGINS=http://localhost:5173,https://reflexityram.com
FRONTEND_URL=http://localhost:5173

# Resend email
RESEND_API_KEY=<resend-api-key>
FROM_EMAIL=Reflexity RAM <noreply@reflexityram.com>
# Optional internal recipient for quote and hardware-acquisition enquiries.
# Defaults to reflexityram@gmail.com when unset.
LEADS_TO_EMAIL=<internal-lead-recipient>

# Cloudinary product images
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Stripe hosted Checkout
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>
STRIPE_CURRENCY=cad

# Optional Google sign-in
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Local/admin seed script. There is deliberately no default admin password.
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<unique-admin-password-at-least-12-characters>

# Optional one-time HTTP seed route. Leave unset to keep /api/seed disabled.
# SEED_SECRET=<one-time-seed-secret>

# Canada Post developer API (tracking emails, international rates). Leave blank to switch them off.
CANADA_POST_API_KEY=
CANADA_POST_API_SECRET=
# Shared secret for POST /api/tracking/sync (also a GitHub Actions secret).
TRACKING_SYNC_TOKEN=
# Optional: customer number for discounted (commercial) Canada Post prices abroad; without it buyers see counter prices.
CANADA_POST_CUSTOMER_NUMBER=
# Postal code parcels are mailed from (default M5H2N2).
CANADA_POST_ORIGIN_POSTAL_CODE=
# Buying Canada Post labels from the admin order page (utils/canadaPostLabels.js). Needs the developer app subscribed to the
# Shipping API and a credit card saved as the default on the Canada Post profile: the card is charged the moment a label is bought.
# Prices can always be looked up; buying only works with this set to true.
CANADA_POST_LABELS_ENABLED=false
# The return address printed on the label. Company, phone, street, city and province are required.
CANADA_POST_SENDER_NAME=
CANADA_POST_SENDER_COMPANY=
CANADA_POST_SENDER_PHONE=
CANADA_POST_SENDER_ADDRESS1=
CANADA_POST_SENDER_ADDRESS2=
CANADA_POST_SENDER_CITY=
CANADA_POST_SENDER_PROVINCE=
# Safety limits: a label dearer than this (CAD incl. tax, default 60) is refused; at most this many labels per 24 hours (default 20).
CANADA_POST_LABEL_MAX_DUE=
CANADA_POST_LABEL_DAILY_LIMIT=
# Minutes after a purchase started before an unclear one (Canada Post did not answer clearly) may be released for a new try by an admin who has
# checked Canada Post's tools and the card statement (default 10).
CANADA_POST_LABEL_RELEASE_WAIT_MINUTES=
# Label size: 8.5x11 (default, a sheet of paper) or 4x6 (a thermal label printer).
CANADA_POST_LABEL_FORMAT=
# Zonos API credential (Zonos dashboard > Settings > Integrations > API key). Quotes the US import duties a US buyer prepays; leave blank and the US stays closed.
ZONOS_API_KEY=
